PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/gt_erp
JWT_SECRET=your_jwt_secret_here

# Optional: Cloudinary configuration for image & document uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Optional: Nodemailer SMTP Configuration for candidate interview notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="GT-ERP Recruitment <recruitment@golden-tech.com>"
